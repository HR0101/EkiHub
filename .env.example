# EkiHub 環境変数のサンプル
# このファイルを .env にコピーして値を設定してください（.env はコミットされません）。
# いずれも任意です。未設定なら埋め込みデータ＋距離概算で動作します。

# 待受ポート（既定: 3000）
# PORT=3000

# ODPTセンターのアクセストークン。
# 設定すると駅データの拡張と、トップ画面の最新運行情報カードが有効になります。
# トークンはサーバー側だけで使用し、ブラウザには送信しません。
# ODPT_TOKEN=your_odpt_token

# ─── 経路API（所要時間・運賃・乗換を実データ化） ───────────────
# 無料・キー不要の構成として OpenTripPlanner(OTP) に対応しています。
# 日本のオープンGTFS（GTFS-JP / 公共交通オープンデータ）を読み込ませたOTPを自前で立て、
# その GraphQL エンドポイントを指定してください。未設定なら距離概算へ自動フォールバックします。
#
# ROUTING_PROVIDER=otp
# ROUTING_OTP_URL=http://localhost:8080/otp/routers/default/index/graphql
# ROUTING_TIMEOUT_MS=8000

# ─── 任意のGoogleログインとグループ保存 ──────────────────────
# 詳細な設定手順は MEMBER_SETUP.md を参照してください。
# AUTH_SECRET=<32バイト以上のランダムな秘密値>
# AUTH_GOOGLE_ID=<OAuthクライアントID>
# AUTH_GOOGLE_SECRET=<OAuthクライアントシークレット>
# AUTH_URL=http://localhost:3001
# 本番では固定の公開URLを指定。リバースプロキシ経由の場合のみ true。
# AUTH_TRUST_HOST=true
# MEMBER_DATABASE_PATH=./var/members.sqlite
